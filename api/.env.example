# Salin ke .env lalu isi. Jangan pernah commit .env.
PORT=4010
PUBLIC_BASE_URL=http://localhost:4010
DATABASE_URL=postgres://jagoai:jagoai_dev@127.0.0.1:5435/jagoai_pay
CORS_ORIGINS=http://localhost:4020

SEED_CONSOLE_EMAIL=operator@jagoai.local
SEED_CONSOLE_PASSWORD=ganti-sandi-ini
SEED_CONSOLE_NAME=Operator JagoAI Pay

# Duitku: kosong = gateway nonaktif (aman). Isi untuk sandbox/produksi.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_BASE_URL=https://sandbox.duitku.com
DUITKU_CHANNELS=SP,BR
# URL callback milik LAYANAN INI. Wajib diisi hanya setelah ada project Duitku sendiri.
# Jangan pakai kredensial jamy: callback-nya mendarat di database jamy.
DUITKU_CALLBACK_URL=

PAY_PUBLIC_BASE_URL=http://localhost:4020

SESSION_COOKIE=jgp_console_session
SESSION_TTL_HARI=7
NODE_ENV=production
